<?xml version="1.0"?>
<ruleset name="Levy EU VAT">
	<file>levy-eu-vat.php</file>
	<file>uninstall.php</file>
	<file>src</file>
	<file>templates</file>
	<file>tests</file>
	<file>e2e</file>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/dist/*</exclude-pattern>
	<arg name="extensions" value="php"/>
	<arg value="ps"/>
	<config name="testVersion" value="7.4-"/>
	<config name="minimum_wp_version" value="6.6"/>
	<rule ref="PHPCompatibilityWP"/>
	<rule ref="WordPress-Extra">
		<exclude name="WordPress.Files.FileName"/>
	</rule>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="levy-eu-vat"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedHooknameFound">
		<!-- Email templates fire WooCommerce's own email header and footer hooks. -->
		<exclude-pattern>*/templates/emails/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="levy_eu_vat"/>
				<element value="Levy\EuVat"/>
				<element value="LEVY_EU_VAT"/>
			</property>
		</properties>
	</rule>
</ruleset>
